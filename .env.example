# Database
DATABASE_URL=postgresql://soleintel:password@localhost:5432/soleintel

# Redis
REDIS_URL=redis://localhost:6379

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# AI/LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# Scrapers
PROXY_URL=http://proxy.example.com:8080
PROXY_USERNAME=
PROXY_PASSWORD=
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Analytics (optional)
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# Authentication (future)
JWT_SECRET=your-secret-key-here
AUTH_ENABLED=false

# Logging
LOG_LEVEL=info
