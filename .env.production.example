# SOLEINTEL Production Environment Variables
# Copy this to .env.production and fill in your actual values

# ============================================
# Core Application Settings
# ============================================
NODE_ENV=production
LOG_LEVEL=info
PORT=3000

# ============================================
# Database & Cache
# ============================================
# From Railway or your database provider
DATABASE_URL=postgresql://user:password@host:5432/soleintel_prod
REDIS_URL=redis://user:password@host:6379

# ============================================
# API Configuration
# ============================================
API_BASE_URL=https://api.soleintel.com
CORS_ORIGIN=https://soleintel.com,https://extension.soleintel.com
API_TIMEOUT=30000
RETRY_ATTEMPTS=3

# ============================================
# Price Tracking & Background Jobs
# ============================================
ENABLE_PRICE_TRACKING=true
PRICE_TRACKING_INTERVAL=360  # 6 hours in minutes
NOTIFICATION_PROCESSING_INTERVAL=60  # 1 hour

# ============================================
# Error Tracking (Sentry)
# ============================================
SENTRY_DSN=https://your-key@your-id.ingest.sentry.io/your-project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# Email Notifications
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@soleintel.com

# Or use SendGrid
# SENDGRID_API_KEY=SG.xxxxxx

# Or use Mailgun
# MAILGUN_API_KEY=key-xxxxx
# MAILGUN_DOMAIN=mg.soleintel.com

# ============================================
# AI & Insights (OpenAI)
# ============================================
OPENAI_API_KEY=sk-proj-xxxxx
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000

# ============================================
# Monitoring & Analytics
# ============================================
# Datadog (optional)
# DATADOG_API_KEY=xxxx
# DATADOG_APP_KEY=xxxx
# DATADOG_SITE=datadoghq.com

# ============================================
# Chrome Extension
# ============================================
EXTENSION_ID=your-extension-id-from-chrome-store
EXTENSION_UPDATE_URL=https://api.soleintel.com/extension/updates

# ============================================
# Security
# ============================================
JWT_SECRET=your-super-secret-jwt-key
ENCRYPTION_KEY=your-encryption-key-for-secrets

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100  # requests per window
RATE_LIMIT_WINDOW=900000  # 15 minutes in ms

# ============================================
# Feature Flags
# ============================================
FEATURE_AI_INSIGHTS=true
FEATURE_EMAIL_ALERTS=true
FEATURE_PRICE_TRACKING=true
FEATURE_WATCHLIST=true

# ============================================
# Deployment Platform
# ============================================
# For Railway.app:
# RAILWAY_ENVIRONMENT_NAME=production
# RAILWAY_PROJECT_NAME=soleintel
# RAILWAY_SERVICE_NAME=api

# ============================================
# Optional: Third-party Services
# ============================================

# Affiliate Network (optional for Week 4)
# AMAZON_ASSOCIATE_ID=soleintel-20
# AFFILIATE_API_KEY=xxxxx

# Payment Processing (optional for Week 4)
# STRIPE_SECRET_KEY=sk_live_xxxxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ============================================
# Notes:
# ============================================
# 1. Never commit actual values to git
# 2. Use Railway/platform's secret management
# 3. Rotate secrets regularly
# 4. Keep different values per environment
# 5. Use strong, random values for secrets
