{
  "manifest_version": 3,
  "name": "SOLEINTEL - Footwear Price Intelligence",
  "short_name": "SOLEINTEL",
  "version": "0.1.0",
  "description": "Bloomberg Terminal for Footwear & Apparel Pricing Intelligence",
  "author": "SOLEINTEL Team",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.shoecarnival.com/*",
    "https://www.nike.com/*",
    "https://www.adidas.com/*",
    "https://www.amazon.com/*",
    "https://www.walmart.com/*",
    "https://www.zappos.com/*",
    "https://www.dsw.com/*",
    "https://www.footlocker.com/*",
    "https://www.target.com/*",
    "https://www.kohls.com/*",
    "https://www.ebay.com/*",
    "https://www.goat.com/*",
    "https://stockx.com/*",
    "https://*.shoecarnival.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOLEINTEL",
    "default_icon": "icons/128.png"
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.shoecarnival.com/*",
        "https://www.nike.com/*",
        "https://www.adidas.com/*",
        "https://www.amazon.com/*",
        "https://www.walmart.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "css": [
        "content-style.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected-script.js"
      ],
      "matches": [
        "https://www.shoecarnival.com/*",
        "https://www.nike.com/*"
      ]
    }
  ]
}
