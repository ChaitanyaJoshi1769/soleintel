// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// PRODUCT DOMAIN
// =====================

model Product {
  id            String   @id @default(cuid())
  sku           String?
  upc           String?
  mpn           String?
  title         String
  description   String?
  brand         String
  category      String   // Legacy: keep for backwards compatibility

  // NEW: Multi-category support
  categoryId    String?
  productCategory ProductCategory? @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   ProductSubcategory? @relation(fields: [subcategoryId], references: [id])

  // NEW: Popularity & trending
  popularityScore Float @default(0)
  trendingRank  Int?

  imageUrl      String?
  msrp          Float?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  variants      ProductVariant[]
  retailers     RetailerListing[]
  history       PriceHistory[]
  sources       ManufacturerSource[]
  insights      ProductInsight[]
  predictions   PricePrediction[]

  @@index([sku])
  @@index([upc])
  @@index([brand])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([popularityScore])
  @@fulltext([title, description])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  color         String?
  size          String?
  style         String?
  colorway      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, color, size])
  @@index([productId])
}

// =====================
// PRODUCT CATEGORIES (Phase 2)
// =====================

model ProductCategory {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  description   String?
  icon          String?  // emoji or icon name
  color         String?  // hex color for UI

  // Stats
  productCount  Int @default(0)
  activeTrackers Int @default(0)
  avgPriceDrop  Float @default(0)

  // Config
  parentCategoryId String?
  parentCategory   ProductCategory? @relation("ParentCategories", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subcategories    ProductCategory[] @relation("ParentCategories")

  scrapingRules Json?  // category-specific parsing rules
  retailerCompatibility Json? // which retailers sell this category

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  subCategories ProductSubcategory[]
  userPreferences UserCategoryPreference[]

  @@index([slug])
  @@index([productCount])
}

model ProductSubcategory {
  id            String   @id @default(cuid())
  categoryId    String
  category      ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name          String   // e.g., "Running Shoes", "Athletic Shoes"
  slug          String
  description   String?
  icon          String?

  productCount  Int @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model UserCategoryPreference {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId    String
  category      ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Notification preferences per category
  alertsEnabled Boolean @default(true)
  alertFrequency String @default("daily") // immediate, daily, weekly

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([userId])
}

// =====================
// RETAILER DOMAIN
// =====================

model Retailer {
  id            String   @id @default(cuid())
  name          String   @unique
  domain        String   @unique
  logo          String?
  trustScore    Float    @default(0)
  category      String   // e.g., "marketplace", "brand", "discount"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listings      RetailerListing[]
  sources       ManufacturerSource[]

  @@index([trustScore])
}

model RetailerListing {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  retailerId    String
  retailer      Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  url           String   @unique
  price         Float
  salePrice     Float?
  discount      Float?   // percentage discount
  inStock       Boolean  @default(true)

  shipping      Float?
  estimatedTax  Float?

  lastUpdated   DateTime @default(now()) @updatedAt

  createdAt     DateTime @default(now())

  @@unique([productId, retailerId])
  @@index([productId])
  @@index([retailerId])
  @@index([price])
}

// =====================
// PRICING HISTORY
// =====================

model PriceHistory {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  price         Float
  retailerId    String?  // nullable for overall market price

  date          DateTime @default(now())

  @@index([productId])
  @@index([date])
  @@index([retailerId])
}

// =====================
// MANUFACTURER / WHOLESALE
// =====================

model ManufacturerSource {
  id            String   @id @default(cuid())
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  retailerId    String
  retailer      Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  sourceType    String   // "alibaba", "aliexpress", "temu", "1688", "factory"
  sourceUrl     String?

  estimatedCost Float?
  confidenceScore Float @default(0) // 0-1

  metadata      Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@index([retailerId])
  @@index([sourceType])
}

// =====================
// AI INSIGHTS
// =====================

model ProductInsight {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  insightType   String   // "overpriced", "fair_value", "underpriced", "wait_for_sale"
  confidence    Float    @default(0)

  message       String
  recommendation String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@index([insightType])
}

// =====================
// PRICING INTELLIGENCE
// =====================

model MarkupAnalysis {
  id            String   @id @default(cuid())
  productId     String   @unique

  msrp          Float?
  averageRetail Float?
  estimatedCost Float?

  estimatedMarkup Float? // percentage

  isLikelyDropship Boolean @default(false)
  dropshipConfidence Float @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// =====================
// TRUST & SCAM DETECTION
// =====================

model TrustScore {
  id            String   @id @default(cuid())
  retailerId    String   @unique
  retailer      Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  overallScore  Float    // 0-100

  reviewScore   Float?
  counterfeitRisk Float? // 0-100
  fakeDiscountIndicators Int @default(0)

  flagged       Boolean  @default(false)
  flagReason    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// =====================
// COUPONS & PROMOTIONS
// =====================

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  retailerId    String
  retailer      Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  discount      Float    // percentage or fixed amount
  minPurchase   Float?

  verified      Boolean  @default(false)
  expiresAt     DateTime?

  lastTested    DateTime?
  testResult    String?  // "success", "invalid", "expired"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([retailerId])
  @@index([verified])
}

// =====================
// WATCHLIST & ALERTS
// =====================

model Watchlist {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId     String

  targetPrice   Float?
  notifyDropPercent Float? // notify if price drops X%

  alerts        PriceAlert[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

model PriceAlert {
  id            String   @id @default(cuid())
  watchlistId   String
  watchlist     Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  priceDropped  Float    // the price it dropped to
  previousPrice Float    // the previous price

  sent          Boolean  @default(false)
  sentAt        DateTime?

  createdAt     DateTime @default(now())

  @@index([watchlistId])
  @@index([sent])
}

// =====================
// SCRAPER METADATA
// =====================

model ScraperJob {
  id            String   @id @default(cuid())
  retailerId    String
  retailer      Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  status        String   @default("pending") // pending, running, completed, failed
  startedAt     DateTime?
  completedAt   DateTime?

  itemsScraped  Int      @default(0)
  errors        Int      @default(0)

  metadata      Json?
  errorLog      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([retailerId])
}

// =====================
// EMBEDDINGS (VECTOR SEARCH)
// =====================

model ProductEmbedding {
  id            String   @id @default(cuid())
  productId     String   @unique

  // pgvector extension would be needed for embedding storage
  // embedding    vector.pgvector(1536) // OpenAI embedding dimension

  embeddingModel String  @default("text-embedding-3-small")
  embeddingSource String  @default("title") // what was embedded

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ImageEmbedding {
  id            String   @id @default(cuid())
  productId     String
  imageUrl      String

  // embedding     vector.pgvector(512) // Vision embedding

  embeddingModel String  @default("clip")

  createdAt     DateTime @default(now())

  @@index([productId])
}

// =====================
// USER & AUTHENTICATION
// =====================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  name          String?

  // Subscription
  tier          String   @default("free") // free, pro, premium
  subscriptionId String?
  subscription  Subscription?

  // Affiliate
  affiliateId   String?
  affiliate     AffiliateAccount?

  // Extension access
  extensionToken String?
  lastLoginAt   DateTime?

  // SMS Notifications
  smsAlertsEnabled Boolean @default(false)
  phoneNumber   UserPhoneNumber?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  watchlists    Watchlist[]
  transactions  Transaction[]
  smsNotifications SmsNotification[]
  smsVerifications SmsVerification[]
  categoryPreferences UserCategoryPreference[] // NEW: Phase 2

  // NEW: Phase 2 Week 3 - Social Features
  sharedWatchlistsOwned SharedWatchlist[] @relation("SharedWatchlistsOwned")
  communityDealsCreated CommunityDeal[] @relation("CommunityDealsCreated")
  achievements  Achievement[] @relation("UserAchievements")
  referralsCreated Referral[] @relation("ReferralsCreated")
  referralsReceived ReferralHistory[] @relation("ReferralsReceived")
  leaderboardEntries LeaderboardEntry[] @relation("LeaderboardEntries")

  @@index([tier])
  @@index([email])
}

// =====================
// SUBSCRIPTION MANAGEMENT
// =====================

model SubscriptionTier {
  id            String   @id @default(cuid())
  name          String   @unique // free, pro, premium
  displayName   String   // "Free", "Pro", "Premium"

  priceMonthly  Float    @default(0)
  priceYearly   Float?

  // Features
  maxWatchlists Int      @default(5)
  maxAlerts     Int      @default(10)
  pricingHistoryDays Int @default(30)
  affiliateRate Float    @default(0) // commission rate for affiliates

  stripePriceId String?  // Stripe price ID for monthly
  stripePriceIdYearly String?

  description   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier          String   // free, pro, premium
  tierDetails   SubscriptionTier?

  status        String   @default("active") // active, canceled, past_due
  stripeCustomerId String?
  stripeSubscriptionId String?

  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  renewalDate   DateTime?

  // Billing
  billingEmail  String?
  billingCycle  String   @default("monthly") // monthly, yearly

  canceledAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([stripeCustomerId])
}

// =====================
// AFFILIATE PROGRAM
// =====================

model AffiliateAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  status        String   @default("pending") // pending, approved, suspended

  // Amazon Associates
  amazonAssociateId String?

  // Paypal for payouts
  paypalEmail   String?

  totalCommissions Float @default(0)
  availableBalance Float @default(0)
  paidOutBalance Float @default(0)

  links         AffiliateLink[]
  commissions   AffiliateCommission[]

  lastPayout    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model AffiliateLink {
  id            String   @id @default(cuid())
  affiliateId   String
  affiliate     AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  productId     String?

  // Source attribution
  source        String   // amazon, affiliate_link, direct
  trackingToken String   @unique

  clicks        Int      @default(0)
  conversions   Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([affiliateId])
  @@index([trackingToken])
}

model AffiliateCommission {
  id            String   @id @default(cuid())
  affiliateId   String
  affiliate     AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  amount        Float
  rate          Float    // commission rate applied

  status        String   @default("pending") // pending, approved, paid

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([affiliateId])
  @@index([status])
}

// =====================
// PAYMENTS & TRANSACTIONS
// =====================

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          String   // subscription, one_time, affiliate_payout
  amount        Float
  currency      String   @default("USD")

  status        String   @default("pending") // pending, completed, failed

  stripePaymentIntentId String?
  stripeChargeId String?

  description   String?
  metadata      Json?

  affiliateCommissions AffiliateCommission[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
}

// =====================
// SMS NOTIFICATIONS
// =====================

model UserPhoneNumber {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber   String
  verified      Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model SmsNotification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber   String
  message       String
  sid           String   // Twilio SID

  status        String   @default("sent") // sent, delivered, failed

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model SmsVerification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber   String
  code          String

  expiresAt     DateTime
  verifiedAt    DateTime?

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([code])
}

// =====================
// ANALYTICS & EVENTS
// =====================

model AnalyticsEvent {
  id            String   @id @default(cuid())
  userId        String?

  eventName     String   // user_signup, user_login, watchlist_created, etc.
  eventType     String   // user, product, conversion, affiliate, system

  properties    Json?    // Additional event data

  timestamp     DateTime @default(now())

  @@index([userId])
  @@index([eventName])
  @@index([eventType])
  @@index([timestamp])
}

// =====================
// PRICE PREDICTIONS (Phase 2)
// =====================

model PricePrediction {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  predictionDate DateTime @default(now())

  prediction7days Float?
  prediction14days Float?
  prediction30days Float?

  confidence7days Float? @default(0)
  confidence14days Float? @default(0)
  confidence30days Float? @default(0)

  recommendation String? // wait, buy, monitor

  actual7daysPrice Float?
  actual14daysPrice Float?
  actual30daysPrice Float?

  accuracy       Float?   // calculated post-prediction

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@index([predictionDate])
}

model ModelMetrics {
  id            String   @id @default(cuid())
  trainingDate  DateTime @default(now())

  totalProductsTrained Int @default(0)
  mae           Float?   // mean absolute error
  rmse          Float?   // root mean squared error
  accuracy      Float?   // % correct predictions
  version       String   @default("1.0")

  createdAt     DateTime @default(now())

  @@index([trainingDate])
}

// =====================
// SOCIAL FEATURES (Phase 2 Week 3)
// =====================

model SharedWatchlist {
  id                    String   @id @default(cuid())
  originalWatchlistId   String
  watchlist             Watchlist @relation(fields: [originalWatchlistId], references: [id], onDelete: Cascade)

  ownerUserId           String
  owner                 User     @relation("SharedWatchlistsOwned", fields: [ownerUserId], references: [id], onDelete: Cascade)

  shareToken            String   @unique
  permissions           String   @default("[\"view\"]") // JSON: ["view"], ["view", "edit"], etc.
  expiresAt             DateTime?

  viewCount             Int      @default(0)
  lastAccessedAt        DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([ownerUserId])
  @@index([shareToken])
  @@index([expiresAt])
}

model CommunityDeal {
  id                    String   @id @default(cuid())
  authorId              String
  author                User     @relation("CommunityDealsCreated", fields: [authorId], references: [id], onDelete: Cascade)

  productId             String
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  retailerId            String?
  dealPrice             Float
  originalPrice         Float
  description           String?

  upvotes               Int      @default(0)
  downvotes             Int      @default(0)
  commentCount          Int      @default(0)

  savingsPercentage     Float
  featured              Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([authorId])
  @@index([productId])
  @@index([createdAt])
  @@index([featured])
}

model Achievement {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation("UserAchievements", fields: [userId], references: [id], onDelete: Cascade)

  achievementType       String   // "first_watchlist", "deal_spotter", "category_expert", "price_prophet", "social_butterfly", "affiliate_king"
  achievementName       String   // Display name
  description           String
  icon                  String   // emoji or icon name

  unlockedAt            DateTime @default(now())

  @@unique([userId, achievementType])
  @@index([userId])
  @@index([achievementType])
}

model Referral {
  id                    String   @id @default(cuid())
  referrerId            String
  referrer              User     @relation("ReferralsCreated", fields: [referrerId], references: [id], onDelete: Cascade)

  referralCode          String   @unique
  referredUserCount     Int      @default(0)
  totalEarned           Float    @default(0)
  rewardPerReferral     Float    @default(5.0)

  active                Boolean  @default(true)

  history               ReferralHistory[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([referralCode])
  @@index([referrerId])
}

model ReferralHistory {
  id                    String   @id @default(cuid())
  referralId            String
  referral              Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  referredUserId        String
  referredUser          User     @relation("ReferralsReceived", fields: [referredUserId], references: [id], onDelete: Cascade)

  rewardAmount          Float
  rewardStatus          String   @default("pending") // pending, completed, refunded

  createdAt             DateTime @default(now())

  @@index([referralId])
  @@index([referredUserId])
}

model LeaderboardEntry {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation("LeaderboardEntries", fields: [userId], references: [id], onDelete: Cascade)

  period                String   // "weekly", "monthly", "alltime"
  totalSavings          Float    @default(0)
  dealsFound            Int      @default(0)
  avgSavingsPerDeal     Float    @default(0)

  rank                  Int?

  updatedAt             DateTime @updatedAt

  @@unique([userId, period])
  @@index([userId])
  @@index([period])
  @@index([rank])
}
